# Portal settings. Not committed (.gitignore).
JWT_SECRET=change-me-generate-with-python-c-import-secrets-print-secrets-token_urlsafe-48
JWT_HOURS=12

PORTAL_DB_NAME=claim_portal

# 0 disables the background replica sync; raise once the source connection works.
REPLICA_SYNC_MINUTES=0

CORS_ORIGINS=http://localhost:5173

# --- DB credentials ---
# Normally these live in the shared easypaisa/.env, which is not present on this machine,
# so they are set here instead (backend/.env is loaded first and wins).

# Portal Postgres (claim_portal)
DB_HOST_EP=192.168.100.237
DB_PORT_EP=5432
DB_USER_EP=
DB_PASSWORD_EP=

# Source SQL Server (Digital_Insurance, read-only)
WEBDOC_SQL2_HOST=
WEBDOC_SQL2_PORT=1433
WEBDOC_SQL2_USER=
WEBDOC_SQL2_PASSWORD=
WEBDOC_SQL2_DATABASE=Digital_Insurance
WEBDOC_SQL2_DRIVER=SQL Server
